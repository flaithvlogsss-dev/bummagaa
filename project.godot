; Engine configuration file.
; LAST SNOW — narrative survival vertical slice.

config_version=5

[application]

config/name="Last Snow"
config/description="Narrative survival adventure prototype: pixel-art characters in a low-poly snowbound city."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)
config/icon="res://icon.svg"

[autoload]

Data="*res://autoload/data_registry.gd"
Settings="*res://autoload/settings.gd"
AudioManager="*res://autoload/audio_manager.gd"
GameState="*res://autoload/game_state.gd"
TimeManager="*res://autoload/time_manager.gd"
WeatherManager="*res://autoload/weather_manager.gd"
QuestManager="*res://autoload/quest_manager.gd"
DialogueManager="*res://autoload/dialogue_manager.gd"
EventManager="*res://autoload/event_manager.gd"
RadioManager="*res://autoload/radio_manager.gd"
SaveManager="*res://autoload/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="enemy"
3d_physics/layer_5="interactable"
3d_physics/layer_6="zone"
3d_physics/layer_7="camera_block"
3d_physics/layer_8="occluder"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=true
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
lights_and_shadows/directional_shadow/size=4096
anti_aliasing/quality/msaa_3d=0

[shader_globals]

snow_amount={
"type": "float",
"value": 0.15
}
