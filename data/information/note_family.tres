[gd_resource type="Resource" script_class="InformationData" format=3]

[ext_resource type="Script" path="res://scripts/core/information_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "note_family"
title = "Записка на холодильнике"
info_type = "note"
content = "«Серёжа! Пропуск дали только на одного. Мы решили: никуда без тебя. Ждём в нашем месте — ты знаешь, за чем. Стучи три раза. Лена и Саша.» Внизу детской рукой нарисован шкаф."
tags = PackedStringArray("family")
sets_flags = PackedStringArray("knows_family_hideout")
