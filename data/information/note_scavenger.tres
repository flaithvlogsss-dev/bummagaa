[gd_resource type="Resource" script_class="InformationData" format=3]

[ext_resource type="Script" path="res://scripts/core/information_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "note_scavenger"
title = "Список мародёра"
info_type = "note"
content = "Огрызком карандаша: «Аптека — пусто. Гаражи: 14-й крепкий, ключ снял со старика у машины (спал). Подстанция — НЕ ХОДИТЬ, там серые. Двор за 12-м — палатки, брать нечего. Если дойду до депо — расскажу Искре про квартал». Дальше — неразборчиво."
tags = PackedStringArray("anton", "route")
sets_flags = PackedStringArray("knows_garage_14")
