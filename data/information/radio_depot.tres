[gd_resource type="Resource" script_class="InformationData" format=3]

[ext_resource type="Script" path="res://scripts/core/information_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "radio_depot"
title = "Радио: выжившие в депо"
info_type = "radio"
content = "«Это депо на Трамвайной. У нас есть тепло и двадцать человек. Если у вас есть передатчик — выходите на 88.9, мы слушаем каждый вечер. Позывной — «Искра»»."
tags = PackedStringArray("radio", "depot")
sets_flags = PackedStringArray("knows_depot")
