[resource]
script = ExtResource("1_s")
id = "voicemail_elias"
title = "Сообщение на автоответчике"
info_type = "note"
content = "«Алекс? Это Элиас из седьмого дома, напротив. Телефоны вот-вот лягут... Если слышишь — не выходи, пока снег не... [треск] ...аптека на площади. Мои таблетки. Если сможешь...»"
tags = PackedStringArray("elias")
