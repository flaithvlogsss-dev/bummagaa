script = ExtResource("1_s")
id = "radio_numbers"
title = "Радио: числа"
info_type = "radio"
content = "Ровный голос читает числа: «…четыре. девять. девять. четыре…» Потом: «Кольцо смыкается. Держите фонари зажжёнными». Тишина. Снова числа."
tags = PackedStringArray("radio", "unknown")
