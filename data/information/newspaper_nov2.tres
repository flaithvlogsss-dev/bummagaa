script = ExtResource("1_s")
id = "newspaper_nov2"
title = "«Северный вестник», 2 ноября"
info_type = "document"
content = "Передовица: «Аномальные холода — явление временное», — заверил представитель проекта «Меридиан». На последней полосе — мелкое объявление: «Требуются добровольцы для полевых испытаний. Оплата сразу. Обращаться: метеостанция, лаборатория 4»."
tags = PackedStringArray("meridian")
