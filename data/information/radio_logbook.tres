[gd_resource type="Resource" script_class="InformationData" format=3]

[ext_resource type="Script" path="res://scripts/core/information_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = "radio_logbook"
title = "Журнал радиоузла"
info_type = "document"
content = "«1.11. Метеостанция «Меридиан» требует освободить частоту 4,99. Отказал — это частота ГО.\n2.11. Пришёл приказ отключить ретранслятор. Не отключил.\n3.11. Снег. У ворот стоят люди в сером, снег на них не ложится.\n3.11, ночь. Антенный блок снял с мачты и спрятал на крыше, под навесом. Пусть ищут. — Дежурный Е. Л.»"
tags = PackedStringArray("elias", "signal")
sets_flags = PackedStringArray("knows_antenna_module")
